BOT_TOKEN=
APP_URL=https://prichalcore.bothost.tech
PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/prichal_core
DATABASE_SSLMODE=verify-full
DATABASE_SSL_CA_B64=
TELEGRAM_WEBHOOK_SECRET=
BOOTSTRAP_ADMIN_TELEGRAM_ID=
APP_TIMEZONE=Asia/Yekaterinburg
APP_ENV=production
LOG_LEVEL=INFO
AUTO_SET_WEBHOOK=true
ENABLE_SCHEDULER=true
SESSION_TTL_HOURS=24
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
PHOTO_REQUEST_TTL_MINUTES=15
MIN_INSPECTIONS_PER_STORE_PER_WEEK=3
PLAN_ALERT_THRESHOLD=0.90
INTERNAL_API_SECRET=
AI_AGENT_URL=
AI_AGENT_SECRET=

# Timeweb S3: one shared bucket, Core uses its own prefix.
PHOTO_STORAGE=s3
S3_ENDPOINT_URL=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=core/photos

# AI directory integration. Base HTTPS URL; AI_AGENT_URL is accepted as fallback.
PRICHAL_AI_URL=
CORE_DIRECTORY_API_KEY=
